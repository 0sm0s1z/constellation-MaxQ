# sourced by maxq-desktop
CHROME_THEME_ID="bkkmolkhemgaeaeggcmfbghljjjoofoh"
CHROME_UPDATE_URL="https://clients2.google.com/service/update2/crx"
CHROME_SKEL="$C/chrome-skel/External Extensions"
CHROME_SKEL_JSON="$CHROME_SKEL/$CHROME_THEME_ID.json"
CHROME_THEME_DIR="$L/share/maxq/chrome-theme-mocha"
CHROME_RECON_BEGIN='# >>> maxq chrome profile theme begin >>>'
CHROME_RECON_END='# <<< maxq chrome profile theme end <<<'
FULL_RECON_BEGIN='# >>> maxq full desired state begin >>>'
FULL_RECON_END='# <<< maxq full desired state end <<<'

chrome_profile_allowed(){ case "$1" in "$P/chrome-profile"|"$P"/chrome-profile-*) return 0;; *) return 1;; esac; }
chrome_profile_dirs(){
  local d seen='|'
  for d in "$P/chrome-profile" "$P"/chrome-profile-* "${CHROME_USER_DATA_DIR:-}"; do
    [ -n "$d" ] && [ -d "$d" ] && chrome_profile_allowed "$d" || continue
    case "$seen" in *"|$d|"*) continue;; esac
    printf '%s\n' "$d"; seen="${seen}${d}|"
  done
}
chrome_external_json_ok(){ python3 - "$1" "$CHROME_UPDATE_URL" <<'PY'
import json,sys
try:d=json.load(open(sys.argv[1],encoding='utf-8'))
except Exception:raise SystemExit(1)
raise SystemExit(0 if d=={'external_update_url':sys.argv[2]} else 1)
PY
}
write_chrome_skeleton(){ mkdir -p "$CHROME_SKEL"; cat > "$CHROME_SKEL_JSON" <<EOF
{
  "external_update_url": "$CHROME_UPDATE_URL"
}
EOF
}
seed_chrome_profile(){
  local p="$1" ext json owned prev
  [ -d "$p" ] && chrome_profile_allowed "$p" || return 0
  ext="$p/External Extensions"; json="$ext/$CHROME_THEME_ID.json"; owned="$json.maxq-owned"; prev="$json.maxq-prev"
  mkdir -p "$ext"
  if [ -e "$json" ] && [ ! -e "$owned" ] && [ ! -e "$prev" ]; then cp -f "$json" "$prev"; fi
  cp -f "$CHROME_SKEL_JSON" "$json"; : > "$owned"
}
seed_all_chrome_profiles(){ local p; while IFS= read -r p; do [ -n "$p" ] && seed_chrome_profile "$p"; done < <(chrome_profile_dirs); }
remove_chrome_profile_seed(){
  local p="$1" json owned prev
  [ -d "$p" ] && chrome_profile_allowed "$p" || return 0
  json="$p/External Extensions/$CHROME_THEME_ID.json"; owned="$json.maxq-owned"; prev="$json.maxq-prev"
  [ -e "$owned" ] || return 0
  if [ -e "$prev" ]; then mv -f "$prev" "$json"; else rm -f "$json"; fi
  rm -f "$owned" "$prev"
}
strip_reconcile_block(){
  local b="$1" e="$2" f="$B/maxq-reconcile" t
  [ -f "$f" ] && grep -qF "$b" "$f" || return 0
  t="$(mktemp "${f}.block.XXXXXX")"; awk -v b="$b" -v e="$e" '$0==b{skip=1;next}$0==e{skip=0;next}!skip{print}' "$f" > "$t"; cat "$t" > "$f"; rm -f "$t"; chmod +x "$f"
}
strip_chrome_reconciler(){ strip_reconcile_block "$CHROME_RECON_BEGIN" "$CHROME_RECON_END"; }
strip_full_reconciler(){ strip_reconcile_block "$FULL_RECON_BEGIN" "$FULL_RECON_END"; }
inject_before_exit(){
  local block="$1" f="$B/maxq-reconcile" t
  [ -f "$f" ] || fail 'maxq-reconcile missing after core apply'
  t="$(mktemp "${f}.inject.XXXXXX")"
  awk -v block="$block" '/^exit 0$/&&!done{while((getline x<block)>0)print x;close(block);done=1}{print}END{if(!done){while((getline x<block)>0)print x;close(block)}}' "$f" > "$t"
  cat "$t" > "$f"; rm -f "$t"; chmod +x "$f"
}
install_chrome_reconciler(){
  local block; strip_full_reconciler; strip_chrome_reconciler
  block="$(mktemp "${TMPDIR:-/tmp}/maxq-chrome-reconcile.XXXXXX")"
  cat > "$block" <<'EOF'
# >>> maxq chrome profile theme begin >>>
MAXQ_CHROME_THEME_ID="bkkmolkhemgaeaeggcmfbghljjjoofoh"
MAXQ_CHROME_SKEL="$PREFIX/.config/maxq/chrome-skel/External Extensions/$MAXQ_CHROME_THEME_ID.json"
maxq_seed_profile(){
  local p="$1" ext json owned prev
  case "$p" in "$PREFIX/chrome-profile"|"$PREFIX"/chrome-profile-*) ;; *) return 0;; esac
  [ -d "$p" ] && [ -s "$MAXQ_CHROME_SKEL" ] || return 0
  ext="$p/External Extensions"; json="$ext/$MAXQ_CHROME_THEME_ID.json"; owned="$json.maxq-owned"; prev="$json.maxq-prev"
  mkdir -p "$ext"
  if [ -e "$json" ] && [ ! -e "$owned" ] && [ ! -e "$prev" ]; then cp -f "$json" "$prev"; fi
  cp -f "$MAXQ_CHROME_SKEL" "$json"; : > "$owned"
}
for maxq_profile in "$PREFIX/chrome-profile" "$PREFIX"/chrome-profile-* "${CHROME_USER_DATA_DIR:-}"; do [ -n "$maxq_profile" ] && maxq_seed_profile "$maxq_profile"; done
unset maxq_profile
# <<< maxq chrome profile theme end <<<
EOF
  inject_before_exit "$block"; rm -f "$block"
  block="$(mktemp "${TMPDIR:-/tmp}/maxq-full-reconcile.XXXXXX")"
  cat > "$block" <<'EOF'
# >>> maxq full desired state begin >>>
# Update recovery source of truth: re-run the public HOME-only MaxQ apply.
if [ -x "$PREFIX/bin/maxq" ]; then exec "$PREFIX/bin/maxq" apply; fi
echo "maxq-reconcile: missing $PREFIX/bin/maxq" >&2
exit 1
# <<< maxq full desired state end <<<
EOF
  inject_before_exit "$block"; rm -f "$block"
}
install_chrome_theme_profiles(){
  [ -s "$CHROME_THEME_DIR/manifest.json" ] || fail 'Chrome Mocha unpacked manifest missing after core apply'
  write_chrome_skeleton; seed_all_chrome_profiles; install_chrome_reconciler
}
remove_chrome_theme_profiles(){
  local p; while IFS= read -r p; do [ -n "$p" ] && remove_chrome_profile_seed "$p"; done < <(chrome_profile_dirs)
  strip_full_reconciler; strip_chrome_reconciler; rm -rf "$C/chrome-skel"
}
check_all_chrome_profiles_seeded(){
  local p j; while IFS= read -r p; do [ -n "$p" ] || continue; j="$p/External Extensions/$CHROME_THEME_ID.json"; chrome_external_json_ok "$j" && [ -e "$j.maxq-owned" ] || return 1; done < <(chrome_profile_dirs)
}
chrome_reconciler_safe(){
  local f="$B/maxq-reconcile"; [ -f "$f" ] || return 1
  grep -qF "$CHROME_RECON_BEGIN" "$f" && grep -q 'chrome-profile-\*' "$f" && grep -qF "$FULL_RECON_BEGIN" "$f" && grep -qF 'exec "$PREFIX/bin/maxq" apply' "$f" || return 1
  awk -v b="$CHROME_RECON_BEGIN" -v e="$FULL_RECON_END" '$0==b{inside=1}$0==e{print;inside=0}inside{print}' "$f" | grep -Eq '(^|[^[:alnum:]_])(kill|killall|pkill)([^[:alnum:]_]|$)|/etc/opt/chrome/policies/managed|--load-extension|ProxyMode|cxn-egress|sand-egress-proxy' && return 1
  return 0
}
