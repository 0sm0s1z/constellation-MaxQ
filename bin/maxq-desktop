#!/usr/bin/env bash
# Supplemental MaxQ desktop composition.
# Core owns wallpaper generation/live paint (#68). maxq-desktop-gate owns the
# final live launcher/Plank/Ghostty release assertions (#69).
set -euo pipefail

P="${MAXQ_HOME:-$HOME}"
B="$P/bin"
C="$P/.config/maxq"
L="$P/.local"
S="$C/desktop"
D="$C/defaults.toml"
J="$C/icons-src"
I="$L/share/icons/maxq"
A="$L/share/applications"
X="$P/.config/xfce4/helpers.rc"
H="$L/share/xfce4/helpers"
E="$P/Desktop"
K="$P/.config/plank/dock1/launchers"
R="$C/launcher"
G="$B/ghostty"
GD="$A/ghostty.desktop"
LA="$B/maxq-launcher"
OS="$B/maxq-open-site"
WP="$L/share/backgrounds/maxq/pastel.png"
GTK="$L/share/themes/MaxQ-Catppuccin-Mocha"
CUR="$L/share/icons/MaxQ-Catppuccin-Mocha"
GC="$P/.config/ghostty/config"
GT="$P/.config/ghostty/themes/catppuccin-mocha.conf"
KEY='/commands/custom/<Super>space'
BEGIN='# >>> maxq desktop begin >>>'
END='# <<< maxq desktop end <<<'
export PATH="$B:$PATH"

for lib in ghostty launcher shortcuts chrome dark; do
  f="$(dirname "$(readlink -f "$0")")/maxq-desktop-$lib"
  [ -r "$f" ] || { echo "maxq-desktop: missing $f" >&2; exit 1; }
  . "$f"
done

fail() { echo "maxq-desktop: $*" >&2; exit 1; }

dirs() {
  mkdir -p "$B" "$C" "$L" "$S" "$J" "$I" "$A" "$H" "$E" "$K" "$R" "$L/opt"
}

defaults() {
  [ -e "$D" ] || cat > "$D" <<'TOML'
default_ai_chat = "chatgpt"
[sites]
chatgpt = "https://chatgpt.com"
grok = "https://grok.com"
claude = "https://claude.ai"
discord = "https://discord.com/app"
slack = "https://app.slack.com/client"
TOML
}

valid_defaults() {
  python3 - "$D" <<'PY'
import sys,tomllib,urllib.parse
try:
    d=tomllib.load(open(sys.argv[1],'rb'))
except Exception:
    raise SystemExit(1)
if d.get('default_ai_chat') not in {'chatgpt','grok','claude'}:
    raise SystemExit(1)
for k in ('chatgpt','grok','claude','discord','slack'):
    u=urllib.parse.urlparse(str(d.get('sites',{}).get(k,'')))
    if u.scheme not in {'http','https'} or not u.netloc:
        raise SystemExit(1)
PY
}

apply_desktop() {
  dirs
  defaults
  valid_defaults || fail 'invalid defaults.toml'

  # Deliberately no wallpaper setter here. #68 core must remain fail-closed on
  # a real visual painter; an XFCE last-image write must never become success.
  apply_dark_mode
  install_icons
  install_ghostty
  install_ghostty_desktop
  set_default_terminal
  install_rofi
  install_launcher
  install_keybind
  install_site_opener
  install_apps
  install_docks
  install_chrome_theme_profiles
  echo applied > "$S/state"
}

revert_desktop() {
  mkdir -p "$C"
  remove_chrome_theme_profiles
  restore_keybind
  restore_default_terminal
  remove_shortcuts
  restore_dark_mode
  rm -f "$LA" "$OS" "$R/mocha.rasi"

  if [ -f "$S/rofi-owned" ]; then
    cache_rofi_root
    rm -f "$B/rofi"
    rm -rf "$L/opt/rofi"
  fi

  if [ -f "$S/ghostty-owned" ] && [ ! -s "$GHOSTTY_APPIMAGE" ] && [ -x "$G" ] && ! ghostty_wrapper_ok; then
    mkdir -p "$C/cli-cache"
    cp -f "$G" "$GHOSTTY_APPIMAGE"
    chmod +x "$GHOSTTY_APPIMAGE"
  fi
  if [ -f "$S/ghostty-preexisting" ] && [ -x "$GHOSTTY_PREEXISTING" ]; then
    cp -f "$GHOSTTY_PREEXISTING" "$G"
    chmod +x "$G"
  elif [ -f "$S/ghostty-owned" ]; then
    rm -f "$G"
    rm -rf "$L/opt/ghostty" "$L/opt/ghostty-appimage"
  fi
  rm -rf "$S"
}

FAIL=0
ok() {
  local name="$1"
  shift
  if "$@"; then
    echo "[PASS] $name"
  else
    echo "[FAIL] $name"
    FAIL=$((FAIL + 1))
  fi
}

check_desktop() {
  # Disk existence only. Live wallpaper paint is exclusively core #68 proof.
  ok 'core pastel wallpaper remains on disk' test -s "$WP"
  ok 'GTK Mocha theme on disk' test -s "$GTK/gtk-3.0/gtk.css"
  ok 'xfwm4 Mocha theme on disk' test -d "$GTK/xfwm4"
  ok 'cursor Mocha theme on disk' test -s "$CUR/index.theme"
  ok 'XFCE dark mode persisted in HOME XML' dark_xml_ok
  [ -z "${DISPLAY:-}" ] || ok 'XFCE dark mode live' dark_live_ok

  ok 'Ghostty at HOME/bin' test -x "$G"
  ok 'command -v ghostty is HOME/bin' test "$(command -v ghostty 2>/dev/null || true)" = "$G"
  ok 'Ghostty wrapper --version' "$G" --version
  ok 'Ghostty Mesa 4.5 wrapper' ghostty_wrapper_ok
  ok 'Ghostty Mocha config on disk' grep -q 'theme = catppuccin-mocha.conf' "$GC"
  ok 'Ghostty Mocha theme on disk' test -s "$GT"
  ok 'Ghostty default helper' grep -qx 'TerminalEmulator=ghostty' "$X"
  ok 'Ghostty desktop file installed' test -s "$GD"
  ok 'Ghostty desktop uses HOME wrapper' grep -qx "Exec=$G" "$GD"

  ok 'defaults.toml valid' valid_defaults
  ok 'launcher choice rofi' grep -qx rofi "$S/launcher"
  ok 'rofi works' rofi -version
  ok 'Mocha launcher theme' test -s "$R/mocha.rasi"
  ok 'launcher executable' test -x "$LA"
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
    ok 'Super+Space XFCE binding' test "$(xfconf-query -c xfce4-keyboard-shortcuts -p "$KEY" 2>/dev/null || true)" = "$LA"
  fi

  ok 'box-chrome current-display opener' sh -c "grep -q box-chrome '$OS' && ! grep -Eq -- '--user-data-dir|chrome-profile-[0-9]' '$OS'"
  ok 'Chrome Mocha unpacked manifest' test -s "$CHROME_THEME_DIR/manifest.json"
  ok 'Chrome Mocha skeleton' chrome_external_json_ok "$CHROME_SKEL_JSON"
  ok 'all existing Chrome profiles seeded' check_all_chrome_profiles_seeded
  ok 'HOME-only full desired-state reconciler installed' chrome_reconciler_safe

  local n
  for n in ai chatgpt grok claude discord slack settings ghostty; do
    ok "PNG icon $n" png_ok "$I/$n.png"
  done
  for n in ai chatgpt grok claude discord slack settings; do
    ok "shortcut $n" test -s "$A/maxq-$n.desktop"
    ok "shortcut $n uses PNG" grep -q "Icon=$I/$n.png" "$A/maxq-$n.desktop"
  done
  for n in maxq-00-ai maxq-10-chatgpt maxq-11-grok maxq-12-claude maxq-20-discord maxq-21-slack maxq-30-settings maxq-40-ghostty; do
    ok "Plank file $n" test -s "$K/$n.dockitem"
  done

  # The richer desktop module writes files only. The eyes-proven live Plank pin
  # is intentionally not asserted here; current maxq-desktop-gate does that last.
  [ ! -f "$B/maxq-reconcile" ] || ok 'reconciler has no /usr/local/bin write' sh -c "! grep -Eq '^[[:space:]]*ln[[:space:]]+-sfn.*\/usr\/local\/bin' '$B/maxq-reconcile'"
}

prove_desktop() {
  FAIL=0
  apply_desktop
  check_desktop
  [ "$FAIL" -eq 0 ]
}

case "${1:-status}" in
  apply|configure) apply_desktop ;;
  revert|unconfigure) revert_desktop ;;
  prove) prove_desktop ;;
  status) [ -f "$S/state" ] && cat "$S/state" || echo reverted ;;
  *) fail 'usage: maxq-desktop apply|revert|prove|status' ;;
esac
