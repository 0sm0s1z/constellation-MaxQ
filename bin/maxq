#!/usr/bin/env bash
# constellation-MaxQ CLI front-end.
# The pre-#69 implementation lives in maxq-core; this wrapper adds the desktop
# release gate without perturbing unrelated installer logic.
set -u

PREFIX="${MAXQ_HOME:-$HOME}"
BIN="$PREFIX/bin"
SELF="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
HERE="$(cd "$(dirname "$SELF")" && pwd)"
CORE="$HERE/maxq-core"
GATE="$HERE/maxq-desktop-gate"

# A repo checkout may be invoking this before install.sh has copied siblings to
# $HOME/bin. Keep the runtime pair current so install_self continues to copy
# this wrapper (not the core) into $HOME/bin/maxq.
if [ "$HERE" != "$BIN" ]; then
  mkdir -p "$BIN"
  if [ -f "$HERE/maxq-core" ]; then cp -f "$HERE/maxq-core" "$BIN/maxq-core"; chmod +x "$BIN/maxq-core"; fi
  if [ -f "$HERE/maxq-desktop-gate" ]; then cp -f "$HERE/maxq-desktop-gate" "$BIN/maxq-desktop-gate"; chmod +x "$BIN/maxq-desktop-gate"; fi
fi

[ -f "$CORE" ] || CORE="$BIN/maxq-core"
[ -x "$GATE" ] || GATE="$BIN/maxq-desktop-gate"
[ -f "$CORE" ] || { echo "maxq: missing runtime core: $CORE" >&2; exit 1; }
[ -x "$GATE" ] || { echo "maxq: missing desktop gate: $GATE" >&2; exit 1; }

# Load all legacy functions but do not execute its trailing main "$@". Sourcing
# keeps $0 pointed at this wrapper, so core install_self preserves the wrapper.
source <(sed '$d' "$CORE")

cmd="${1:-status}"

if [ "$cmd" = "prove" ]; then
  # cmd_prove intentionally calls exit. Run it in a subshell, then enforce the
  # #69 gate against the final APPLIED state and combine exit status honestly.
  # Replace the legacy config-only Ghostty summary; the gate below reports the
  # actual binary/version result.
  set +e
  ( cmd_prove ) 2>&1 | sed 's/^ghostty_bin=skipped (no official linux amd64)$/ghostty_bin=validated-by-desktop-gate-below/'
  core_rc=${PIPESTATUS[0]}
  "$GATE" apply
  gate_apply_rc=$?
  "$GATE" prove
  gate_rc=$?
  set -e
  if [ "$core_rc" -ne 0 ] || [ "$gate_apply_rc" -ne 0 ] || [ "$gate_rc" -ne 0 ]; then
    exit 1
  fi
  exit 0
fi

set +e
main "$@"
core_rc=$?
set -e
[ "$core_rc" -eq 0 ] || exit "$core_rc"

case "$cmd" in
  apply|configure)
    "$GATE" apply
    ;;
  revert|unconfigure)
    "$GATE" revert
    ;;
esac
