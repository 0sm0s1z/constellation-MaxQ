mark_owned() {
  mkdir -p "$1"
  printf 'constellation-MaxQ\n' > "$1/.maxq-owned"
}

theme_pack_candidates() {
  local here src
  src="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  here="$(cd "$(dirname "$src")" && pwd)"
  printf '%s\n' "$here/../share/theme"
  printf '%s\n' "$here/share/theme"
  printf '%s\n' "$THEME_SRC"
}

seed_theme_src() {
  mkdir -p "$THEME_SRC"
  local cand
  while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    [ -d "$cand" ] || continue
    # Do not copy THEME_SRC onto itself.
    if [ "$(readlink -f "$cand" 2>/dev/null || true)" = "$(readlink -f "$THEME_SRC" 2>/dev/null || true)" ]; then
      continue
    fi
    cp -a "$cand"/. "$THEME_SRC"/
  done < <(theme_pack_candidates)
}

download_if_missing() {
  local dest="$1" url="$2"
  [ -s "$dest" ] && return 0
  mkdir -p "$(dirname "$dest")"
  curl -fsSL -o "$dest" "$url" || rm -f "$dest"
  [ -s "$dest" ]
}

generate_wallpaper() {
  local dest="$1"
  python3 - "$dest" <<'PY'
import sys
from PIL import Image, ImageDraw, ImageFilter, ImageFont
dest = sys.argv[1]
w, h = 1920, 1080
crust, mantle, base = (255, 248, 244), (246, 238, 250), (234, 242, 250)
text, sub, mauve = (55, 49, 72), (96, 88, 112), (173, 132, 207)
blue, lavender, peach = (126, 177, 222), (179, 158, 219), (245, 174, 153)
teal, green, sky = (148, 226, 213), (166, 227, 161), (137, 220, 235)
red, yellow, pink = (243, 139, 168), (249, 226, 175), (245, 194, 231)
img = Image.new("RGB", (w, h), crust)
px = img.load()
for y in range(h):
    t = y / (h - 1)
    if t < 0.45:
        u = t / 0.45
        r = int(crust[0] + (base[0] - crust[0]) * u)
        g = int(crust[1] + (base[1] - crust[1]) * u)
        b = int(crust[2] + (base[2] - crust[2]) * u)
    else:
        u = (t - 0.45) / 0.55
        r = int(base[0] + (mantle[0] - base[0]) * u)
        g = int(base[1] + (mantle[1] - base[1]) * u)
        b = int(base[2] + (mantle[2] - base[2]) * u)
    for x in range(w):
        px[x, y] = (min(255, r + int(6 * x / (w - 1))), g, b)
img = img.convert("RGBA")
acc = Image.new("RGBA", (w, h), (0, 0, 0, 0))

def orb(cx, cy, rad, color, alpha):
    layer = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    ImageDraw.Draw(layer).ellipse((cx-rad, cy-rad, cx+rad, cy+rad), fill=color+(alpha,))
    return layer.filter(ImageFilter.GaussianBlur(radius=rad*0.35))

for args in ((420,280,340,mauve,55),(1500,220,280,blue,50),(1620,820,360,teal,40),(280,860,260,peach,35),(980,520,220,lavender,30)):
    acc = Image.alpha_composite(acc, orb(*args))
img = Image.alpha_composite(img, acc)
d = ImageDraw.Draw(img, "RGBA")
bars = [red, peach, yellow, green, teal, sky, blue, lavender, mauve, pink]
x0, y0, bw, bh, gap = 120, 860, 70, 28, 10
for i, c in enumerate(bars):
    x = x0 + i*(bw+gap)
    d.rounded_rectangle((x, y0, x+bw, y0+bh), radius=8, fill=c+(230,))
d.rectangle((0, 0, w, 6), fill=mauve+(255,))
try:
    font_lg = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 120)
    font_sm = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 36)
    font_xs = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 22)
except Exception:
    font_lg = font_sm = font_xs = ImageFont.load_default()
d.text((120, 280), "MaxQ", font=font_lg, fill=text+(255,))
d.text((128, 420), "Pastel operator desktop", font=font_sm, fill=mauve+(255,))
d.text((128, 480), "Take your Grok Bot to MaxQ.", font=font_xs, fill=sub+(255,))
# Subtle terminal-style shortcut card in the top-right.
card_x, card_y, card_w, card_h = 1210, 76, 610, 292
d.rounded_rectangle((card_x, card_y, card_x+card_w, card_y+card_h), radius=18, fill=(255,255,255,185), outline=(173,132,207,180), width=2)
d.text((card_x+26, card_y+18), "MAXQ // SHORTCUTS", font=font_xs, fill=mauve+(255,))
rows = [("Super+Space", "app launcher"), ("maxq apply", "apply desktop"), ("maxq status", "show state"), ("maxq prove", "verify setup")]
for i, (key, action) in enumerate(rows):
    y = card_y + 62 + i*49
    d.text((card_x+26, y), key, font=font_xs, fill=text+(255,))
    d.text((card_x+280, y), action, font=font_xs, fill=sub+(255,))
q = img.convert("RGB").quantize(colors=64, method=Image.Quantize.MEDIANCUT)
q.save(dest, format="PNG", optimize=True)
PY
}

