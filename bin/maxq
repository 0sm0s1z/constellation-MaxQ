install_marked_block() {
  local f="$1"
  mkdir -p "$(dirname "$f")"
  if [ ! -f "$f" ]; then
    touch "$f"
  fi
  if has_profile_block "$f"; then
    return 0
  fi
  if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l)" -eq 0 ]; then
    printf '\n' >> "$f"
  fi
  printf '\n' >> "$f"
  cat >> "$f"
}

extract_zip_dir() {
  # extract_zip_dir zip dest [preferred-top-dir-glob]
  local zip="$1" dest="$2" prefer="${3:-}"
  local tmp pick
  [ -s "$zip" ] || return 1
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/maxq-theme.XXXXXX")"
  if ! unzip -q "$zip" -d "$tmp"; then
    rm -rf "$tmp"
    return 1
  fi
  pick=""
  if [ -n "$prefer" ] && [ -d "$tmp/$prefer" ]; then
    pick="$tmp/$prefer"
  else
    pick="$(python3 - "$tmp" <<'PY'
import os, sys
root = sys.argv[1]
cands = []
for name in sorted(os.listdir(root)):
    p = os.path.join(root, name)
    if os.path.isdir(p) and ("hdpi" not in name.lower()):
        if os.path.isfile(os.path.join(p, "index.theme")) or os.path.isfile(os.path.join(p, "manifest.json")):
            cands.append(p)
if not cands:
    for dirpath, dirnames, filenames in os.walk(root):
        if "index.theme" in filenames or "manifest.json" in filenames:
            cands.append(dirpath)
            break
print(cands[0] if cands else "")
PY
)"
  fi
  if [ -z "$pick" ] || [ ! -d "$pick" ]; then
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$dest"
  mkdir -p "$(dirname "$dest")"
  cp -a "$pick" "$dest"
  rm -rf "$tmp"
  return 0
}

rewrite_gtk_index() {
  local dest="$1"
  local idx="$dest/index.theme"
  [ -f "$idx" ] || return 0
  python3 - "$idx" "$GTK_THEME_NAME" "$CURSOR_THEME_NAME" <<'PY'
import sys
path, name, cursor = sys.argv[1], sys.argv[2], sys.argv[3]
text = open(path).read()
repl = {
    "Name=": f"Name={name}",
    "GtkTheme=": f"GtkTheme={name}",
    "MetacityTheme=": f"MetacityTheme={name}",
    "CursorTheme=": f"CursorTheme={cursor}",
}
out = []
for line in text.splitlines(True):
    stripped = line.lstrip()
    done = False
    for k, v in repl.items():
        if stripped.startswith(k):
            nl = "\n" if line.endswith("\n") else ""
            out.append(v + nl)
            done = True
            break
    if not done:
        out.append(line)
open(path, "w").writelines(out)
PY
}

rewrite_cursor_index() {
  local dest="$1"
  local idx="$dest/index.theme"
  mkdir -p "$dest"
  if [ -f "$idx" ]; then
    python3 - "$idx" "$CURSOR_THEME_NAME" <<'PY'
import sys
path, name = sys.argv[1], sys.argv[2]
lines = []
for line in open(path):
    if line.startswith("Name="):
        lines.append(f"Name={name}\n")
    else:
        lines.append(line)
open(path, "w").writelines(lines)
PY
  else
    cat > "$idx" <<EOF
[Icon Theme]
Name=${CURSOR_THEME_NAME}
Comment=MaxQ Catppuccin Mocha cursors
Inherits=Adwaita
EOF
  fi
}

install_wallpaper() {
  mkdir -p "$WALLPAPER_DIR"
  if [ -s "$THEME_SRC/wallpaper/pastel.png" ]; then
    cp -f "$THEME_SRC/wallpaper/pastel.png" "$WALLPAPER"
  elif [ -s "$THEME_SRC/wallpaper/mocha.png" ]; then
    cp -f "$THEME_SRC/wallpaper/mocha.png" "$WALLPAPER"
  else
    generate_wallpaper "$WALLPAPER"
  fi
  mark_owned "$WALLPAPER_DIR"
}

apply_wallpaper_live() {
  # Live application is best-effort and never blocks apply on headless bots.
  [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] || return 0
  local uri="file://$WALLPAPER"
  if command -v gsettings >/dev/null 2>&1; then
    gsettings set org.gnome.desktop.background picture-uri "$uri" 2>/dev/null || true
    gsettings set org.gnome.desktop.background picture-uri-dark "$uri" 2>/dev/null || true
  fi
  if command -v feh >/dev/null 2>&1; then
    feh --no-fehbg --bg-fill "$WALLPAPER" >/dev/null 2>&1 || true
  elif command -v nitrogen >/dev/null 2>&1; then
    nitrogen --set-zoom-fill "$WALLPAPER" >/dev/null 2>&1 || true
  elif command -v swaymsg >/dev/null 2>&1; then
    swaymsg output '*' bg "$WALLPAPER" fill >/dev/null 2>&1 || true
  fi
}

install_launcher() {
  mkdir -p "$LOCAL/share/applications" "$CONFIG"
  if [ -s "$THEME_SRC/launcher/maxq-launcher" ]; then
    cp -f "$THEME_SRC/launcher/maxq-launcher" "$LAUNCHER_BIN"
  else
    cat > "$LAUNCHER_BIN" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
if command -v rofi >/dev/null 2>&1; then exec rofi -show drun; fi
if command -v fuzzel >/dev/null 2>&1; then exec fuzzel; fi
if command -v wofi >/dev/null 2>&1; then exec wofi --show drun; fi
if command -v dmenu_run >/dev/null 2>&1; then exec dmenu_run; fi
exec gtk-launch maxq-launcher
EOF
  fi
  chmod +x "$LAUNCHER_BIN"
  cat > "$LAUNCHER_DESKTOP" <<EOF
[Desktop Entry]
Type=Application
Name=MaxQ App Launcher
Comment=Launch applications with the MaxQ launcher
Exec=$LAUNCHER_BIN
Terminal=false
Categories=Utility;System;
Keywords=launcher;rofi;apps;MaxQ;
EOF
  cat > "$SHORTCUTS_FILE" <<EOF
# MaxQ desktop shortcuts (managed)
# Primary binding: Super+Space -> $LAUNCHER_BIN
launcher = Super+Space
apply = maxq apply
status = maxq status
prove = maxq prove
EOF
  if command -v gsettings >/dev/null 2>&1; then
    local schema uri current updated
    schema="org.gnome.settings-daemon.plugins.media-keys"
    uri="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/maxq-launcher/"
    dconf write "$uri/name" "'MaxQ App Launcher'" 2>/dev/null || true
    dconf write "$uri/command" "'$LAUNCHER_BIN'" 2>/dev/null || true
    dconf write "$uri/binding" "'<Super>space'" 2>/dev/null || true
    current="$(gsettings get "$schema" custom-keybindings 2>/dev/null || printf '@as []')"
    case "$current" in
      *"$uri"*) updated="$current" ;;
      "@as []") updated="['$uri']" ;;
      *) updated="${current%]} , '$uri']" ;;
    esac
    gsettings set "$schema" custom-keybindings "$updated" 2>/dev/null || true
  fi
}

install_gtk_theme() {
  mkdir -p "$LOCAL/share/themes"
  local zip="$THEME_SRC/vendor/$GTK_VENDOR_ZIP"
  download_if_missing "$zip" "$GTK_VENDOR_URL" || true
  if extract_zip_dir "$zip" "$GTK_THEME_DIR" "catppuccin-mocha-mauve-standard+default"; then
    rewrite_gtk_index "$GTK_THEME_DIR"
    mark_owned "$GTK_THEME_DIR"
  else
    write_compact_gtk_theme "$GTK_THEME_DIR"
  fi
}

install_cursor_theme() {
  mkdir -p "$LOCAL/share/icons"
  local zip="$THEME_SRC/vendor/$CURSOR_VENDOR_ZIP"
  download_if_missing "$zip" "$CURSOR_VENDOR_URL" || true
  if extract_zip_dir "$zip" "$CURSOR_DIR" "catppuccin-mocha-mauve-cursors"; then
    rewrite_cursor_index "$CURSOR_DIR"
    mark_owned "$CURSOR_DIR"
  else
    write_fallback_cursor "$CURSOR_DIR"
  fi
}

install_chrome_theme() {
  mkdir -p "$LOCAL/share/maxq"
  if [ -f "$THEME_SRC/chrome-mocha/manifest.json" ]; then
    rm -rf "$CHROME_THEME_DIR"
    cp -a "$THEME_SRC/chrome-mocha" "$CHROME_THEME_DIR"
  else
    local zip="$THEME_SRC/vendor/catppuccin-chrome-mocha-google-store.zip"
    download_if_missing "$zip" "$CHROME_VENDOR_URL" || true
    if ! extract_zip_dir "$zip" "$CHROME_THEME_DIR" ""; then
      rm -rf "$CHROME_THEME_DIR"
      write_chrome_fallback "$CHROME_THEME_DIR"
    fi
  fi
  write_chrome_note "$CHROME_THEME_DIR"
  mark_owned "$CHROME_THEME_DIR"
  mark_owned "$LOCAL/share/maxq"
}

install_ghostty_theme() {
  mkdir -p "$GHOSTTY_DIR/themes"
  write_ghostty_theme_file "$GHOSTTY_THEME_FILE"
  if ! has_profile_block "$GHOSTTY_CONFIG"; then
    ghostty_block | install_marked_block "$GHOSTTY_CONFIG"
  fi
  # No official linux amd64 Ghostty binary. Config-only; do not install AppImage.
  if [ -e "$GHOSTTY_BIN" ]; then
    :
  fi
}

install_gtk_settings() {
  mkdir -p "$PREFIX/.config/gtk-3.0" "$PREFIX/.config/gtk-4.0"
  if ! has_profile_block "$GTK3_INI"; then
    gtk_settings_block | install_marked_block "$GTK3_INI"
  fi
  if ! has_profile_block "$GTK4_INI"; then
    gtk_settings_block | install_marked_block "$GTK4_INI"
  fi
}

write_theme_readme() {
  mkdir -p "$THEME_ROOT"
  cat > "$THEME_ROOT/README.md" <<EOF
# MaxQ theme (Catppuccin Mocha)

theme = mocha (latte is a future flag only).

Installed (MaxQ-owned; revert removes these dest files):

- wallpaper: $WALLPAPER
- launcher: $LAUNCHER_BIN (Super+Space)
- desktop entry: $LAUNCHER_DESKTOP
- GTK: $GTK_THEME_DIR
- cursor: $CURSOR_DIR
- Ghostty config block: $GHOSTTY_CONFIG
- Ghostty Mocha theme: $GHOSTTY_THEME_FILE
- Chrome unpacked: $CHROME_THEME_DIR
- Chrome Web Store ID: $CHROME_STORE_ID

Ghostty binary: skipped (no official linux amd64 build). Config-only.
Chrome theme: files shipped; not live-applied (no flags, no managed policies).
Vendor cache kept at $THEME_SRC across revert (like the CA).
EOF
}

apply_theme() {
  # Always Mocha for v0. Latte is a flag only.
  THEME="mocha"
  seed_theme_src
  install_wallpaper
  apply_wallpaper_live
  install_launcher
  install_gtk_theme
  install_cursor_theme
  install_ghostty_theme
  install_chrome_theme
  install_gtk_settings
  write_theme_readme
}

revert_theme() {
  strip_profile_hook "$GHOSTTY_CONFIG"
  strip_profile_hook "$GTK3_INI"
  strip_profile_hook "$GTK4_INI"
  local p
  for p in "$WALLPAPER" "$GHOSTTY_THEME_FILE" "$LAUNCHER_BIN" "$LAUNCHER_DESKTOP" "$SHORTCUTS_FILE"; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -f "$p"
      echo "  $p" >> "$REVERT_LOG"
    fi
  done
  for p in "$WALLPAPER_DIR" "$GTK_THEME_DIR" "$CURSOR_DIR" "$CHROME_THEME_DIR"; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -rf "$p"
      echo "  $p" >> "$REVERT_LOG"
    fi
  done
  # Drop empty parents we created, never $HOME/.local/share itself.
  rmdir "$LOCAL/share/maxq" 2>/dev/null || true
  rmdir "$GHOSTTY_DIR/themes" 2>/dev/null || true
  if [ -f "$GHOSTTY_CONFIG" ] && [ ! -s "$GHOSTTY_CONFIG" ]; then
    rm -f "$GHOSTTY_CONFIG"
    rmdir "$GHOSTTY_DIR" 2>/dev/null || true
  fi
  if [ -f "$GTK3_INI" ] && [ ! -s "$GTK3_INI" ]; then
    rm -f "$GTK3_INI"
  fi
  if [ -f "$GTK4_INI" ] && [ ! -s "$GTK4_INI" ]; then
    rm -f "$GTK4_INI"
  fi
  # Keep $THEME_SRC (vendor cache) like the persist CA.
}


# --- operator CLIs (PLAN 9) -------------------------------------------------

cli_latest_text() {
  curl -fsSL "$1" 2>/dev/null | tr -d '\r' | head -n1 | tr -d '[:space:]' || true
}

is_elf_or_script() {
  local f="$1"
  [ -s "$f" ] || return 1
  local mag
  mag="$(head -c 4 "$f" 2>/dev/null || true)"
  if [ "$mag" = $'\x7fELF' ]; then
    return 0
  fi
  mag="$(head -c 2 "$f" 2>/dev/null || true)"
  [ "$mag" = '#!' ]
}

cli_owned() {
  [ -f "$MANAGED_CLIS/$1" ]
}

cli_claim() {
  mkdir -p "$MANAGED_CLIS"
  printf 'constellation-MaxQ\n' > "$MANAGED_CLIS/$1"
}

cli_record() {
  local name="$1" status="$2" extra="${3:-}"
  case "$status" in
    installed)
      CLI_INSTALLED="${CLI_INSTALLED:+$CLI_INSTALLED }$name"
      ;;
    skipped)
      CLI_SKIPPED="${CLI_SKIPPED:+$CLI_SKIPPED }$name"
      ;;
  esac
  printf '%-12s %-12s %s\n' "$name" "$status" "$extra" >> "$CLIS_TXT"
}

cli_fetch() {
  local url="$1" dest="$2"
  if [ -s "$dest" ]; then
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  local tmp="${dest}.part"
  if curl -fL --retry 3 --retry-delay 1 -o "$tmp" "$url" && [ -s "$tmp" ]; then
    mv -f "$tmp" "$dest"
    return 0
  fi
  rm -f "$tmp"
  return 1
}


cli_place() {
  local name="$1" src="$2"
  local dest="$BIN/$name"
  mkdir -p "$BIN"
  if ! is_elf_or_script "$src"; then
    return 1
  fi
  chmod +x "$src" 2>/dev/null || true
  cp -f "$src" "$dest"
  chmod +x "$dest"
  if ! is_elf_or_script "$dest"; then
    rm -f "$dest"
    return 1
  fi
  cli_claim "$name"
  cli_record "$name" installed "$dest owned"
  return 0
}

cli_pick_extracted() {
  local root="$1" name="$2"
  python3 - "$root" "$name" <<'PY'
import os, sys
root, name = sys.argv[1], sys.argv[2]
cands = []
for dirpath, _, filenames in os.walk(root):
    for fn in filenames:
        p = os.path.join(dirpath, fn)
        if not os.path.isfile(p):
            continue
        if fn == name or fn.startswith(name + "-"):
            cands.append(p)
if not cands:
    for dirpath, _, filenames in os.walk(root):
        for fn in filenames:
            p = os.path.join(dirpath, fn)
            if os.path.isfile(p) and os.access(p, os.X_OK):
                cands.append(p)
                break
print(cands[0] if cands else "")
PY
}

cli_try_raw() {
  local name="$1" url="$2"
  echo "maxq: operator CLI $name <- $url"
  if ! cli_fetch "$url" "$CLI_CACHE/${name}.bin"; then
    cli_record "$name" skipped "download failed (no linux amd64 binary?)"
    return 0
  fi
  if ! cli_place "$name" "$CLI_CACHE/${name}.bin"; then
    cli_record "$name" skipped "not a linux amd64 binary/script"
  fi
  return 0
}

cli_try_targz() {
  local name="$1" url="$2"
  echo "maxq: operator CLI $name <- $url"
  local tgz="$CLI_CACHE/${name}.tar.gz"
  local extract="$CLI_CACHE/${name}.extract"
  local bin="$CLI_CACHE/${name}.bin"
  if [ -s "$bin" ] && is_elf_or_script "$bin"; then
    if ! cli_place "$name" "$bin"; then
      cli_record "$name" skipped "not a linux amd64 binary/script"
    fi
    return 0
  fi
  if ! cli_fetch "$url" "$tgz"; then
    cli_record "$name" skipped "download failed (no linux amd64 archive?)"
    return 0
  fi
  rm -rf "$extract"
  mkdir -p "$extract"
  if ! tar -xzf "$tgz" -C "$extract" 2>/dev/null; then
    cli_record "$name" skipped "archive extract failed"
    return 0
  fi
  local pick
  pick="$(cli_pick_extracted "$extract" "$name")"
  if [ -z "$pick" ] || [ ! -f "$pick" ]; then
    cli_record "$name" skipped "archive missing linux amd64 binary"
    return 0
  fi
  cp -f "$pick" "$bin"
  if ! cli_place "$name" "$bin"; then
    cli_record "$name" skipped "not a linux amd64 binary/script"
  fi
  return 0
}

cli_try_gz() {
  local name="$1" url="$2"
  echo "maxq: operator CLI $name <- $url"
  local gz="$CLI_CACHE/${name}.gz"
  local bin="$CLI_CACHE/${name}.bin"
  if ! cli_fetch "$url" "$gz"; then
    cli_record "$name" skipped "download failed (no linux amd64 binary?)"
    return 0
  fi
  if [ ! -s "$bin" ]; then
    if gzip -dc "$gz" > "$bin" 2>/dev/null && is_elf_or_script "$bin"; then
      :
    elif is_elf_or_script "$gz"; then
      cp -f "$gz" "$bin"
    else
      rm -f "$bin"
      cli_record "$name" skipped "decompress failed"
      return 0
    fi
  fi
  if ! cli_place "$name" "$bin"; then
    cli_record "$name" skipped "not a linux amd64 binary/script"
  fi
  return 0
}

apply_operator_clis() {
  mkdir -p "$BIN" "$CLI_CACHE" "$MANAGED_CLIS"
  CLI_INSTALLED=""
  CLI_SKIPPED=""
  cat > "$CLIS_TXT" <<EOF
# MaxQ operator CLIs (linux amd64). Managed — rewritten on apply.
# status: installed | skipped
# Revert deletes MaxQ-owned binaries only (markers in $MANAGED_CLIS).
# Never delete ~/.ssh or Chrome.
EOF

  # herdr — official linux x86_64 release binary
  cli_try_raw herdr "https://github.com/herdrdev/herdr/releases/latest/download/herdr-linux-x86_64"

  # Vercel fx — official linux x86_64 tarball
  local fxver
  fxver="$(cli_latest_text https://releases.fx.sh/latest.txt)"
  [ -n "$fxver" ] || fxver="v0.0.7"
  case "$fxver" in
    v*) ;;
    *) fxver="v${fxver}" ;;
  esac
  cli_try_targz fx "https://github.com/vercel-labs/fx/releases/download/${fxver}/fx-linux-x86_64.tar.gz"

  # Grok Build CLI — official linux x86_64 gzip binary
  local gver
  gver="$(cli_latest_text https://x.ai/cli/stable)"
  [ -n "$gver" ] || gver="1.0.13"
  cli_try_gz grok "https://x.ai/cli/grok-${gver}-linux-x86_64.gz"

  # OpenAI Codex CLI — official musl linux amd64 tarball
  cli_try_targz codex "https://github.com/openai/codex/releases/latest/download/codex-x86_64-unknown-linux-musl.tar.gz"

  # Claude Code — official native linux-x64 binary
  local cver
  cver="$(cli_latest_text https://downloads.claude.ai/claude-code-releases/latest)"
  if [ -n "$cver" ]; then
    cli_try_raw claude "https://downloads.claude.ai/claude-code-releases/${cver}/linux-x64/claude"
  else
    cli_record claude skipped "no linux amd64 release pointer"
  fi

  # OpenCode, Tailscale, and tailscaled are MaxQ-owned operator CLIs.
  cli_try_targz opencode "https://github.com/anomalyco/opencode/releases/latest/download/opencode-linux-x64.tar.gz"
  cli_try_targz tailscale "https://pkgs.tailscale.com/stable/tailscale_latest_amd64.tgz"
  cli_try_targz tailscaled "https://pkgs.tailscale.com/stable/tailscale_latest_amd64.tgz"
}

revert_operator_clis() {
  local name dest
  if [ -d "$MANAGED_CLIS" ]; then
    for name in $(ls "$MANAGED_CLIS" 2>/dev/null || true); do
      dest="$BIN/$name"
      if [ -e "$dest" ] || [ -L "$dest" ]; then
        rm -f "$dest"
        echo "  $dest (MaxQ-owned CLI)" >> "$REVERT_LOG"
      fi
      rm -f "$MANAGED_CLIS/$name"
    done
    rmdir "$MANAGED_CLIS" 2>/dev/null || true
  fi
  if [ -e "$CLIS_TXT" ]; then
    rm -f "$CLIS_TXT"
    echo "  $CLIS_TXT" >> "$REVERT_LOG"
  fi
  # Keep $CLI_CACHE (like CA / theme vendor). Never ~/.ssh or Chrome.
}


# --- apply / revert / status ------------------------------------------------

cmd_apply() {
  mkdir -p "$BIN" "$CONFIG" "$LOCAL" "$CA_DIR" \
    "$LOCAL/share/themes" "$LOCAL/share/icons" "$LOCAL/share/backgrounds" \
    "$CONFIG/theme" "$CLI_CACHE" "$API_SRC"
  load_settings
  THEME="mocha"
  install_self
  install_gost_binary
  ensure_ca
  apply_theme
  apply_operator_clis
  write_toml
  write_profile_snippet
  write_reconcile
  printf 'applied\n' > "$STATE_FILE"
  printf 'constellation-MaxQ\n' > "$MANAGED"
  install_profile_hook "$PREFIX/.profile"
  install_profile_hook "$PREFIX/.bashrc"
  optional_usr_link
  apply_proxy_runtime
  start_api
  echo "MaxQ applied. theme=$THEME state=applied gost.enabled=$GOST_ENABLED intercept=$GOST_INTERCEPT prefix=$PREFIX api=$API_LISTEN chrome_theme=$CHROME_THEME_DIR clis.installed=$CLI_INSTALLED clis.skipped=$CLI_SKIPPED"
}

cmd_revert() {
  mkdir -p "$CONFIG"
  load_settings
  local ts host
  ts="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  host="$(hostname 2>/dev/null || echo unknown)"

  {
    echo "maxq revert $ts"
    echo "host=$host"
    echo "prefix=$PREFIX"
    echo "user=${USER:-$(id -un 2>/dev/null || echo unknown)}"
    echo "removed:"
  } > "$REVERT_LOG"

  stop_gost
  echo "  gost process (pidfile)" >> "$REVERT_LOG"
  stop_api
  echo "  maxq-api process (pidfile)" >> "$REVERT_LOG"

  strip_profile_hook "$PREFIX/.profile"
  strip_profile_hook "$PREFIX/.bashrc"
  echo "  profile hooks (.profile .bashrc)" >> "$REVERT_LOG"

  remove_optional_usr_link
  echo "  optional usr link (if owned)" >> "$REVERT_LOG"

  revert_theme
  echo "  MaxQ-owned theme dest files" >> "$REVERT_LOG"

  revert_operator_clis
  echo "  MaxQ-owned operator CLIs" >> "$REVERT_LOG"

  # Explicit MaxQ-owned paths only. Never $HOME, never .ssh, never Chrome.
  # Never delete Chrome policies (cxn-egress.json, sand.json, …).
  # Never destroy the persist CA.
  local p
  for p in "$TOML" "$PROFILE_SNIPPET" "$MANAGED" "$RECONCILE" "$GOST_YML" "$GOST_PID" "$GOST_LOG" "$API_TOML" "$API_PID" "$API_LOG"; do
    if [ -e "$p" ] || [ -L "$p" ]; then
      rm -f "$p"
      echo "  $p" >> "$REVERT_LOG"
    fi
  done

  printf 'reverted\n' > "$STATE_FILE"
  {
    echo "preserved:"
    echo "  HOME=$PREFIX (not deleted)"
    echo "  SSH=$PREFIX/.ssh (untouched)"
    echo "  Chrome logins/profiles (untouched)"
    echo "  Chrome policies under $CHROME_POLICY_DIR (untouched; MaxQ writes none)"
    echo "  CA=$CA_DIR (kept)"
    echo "  CLI=$BIN/maxq (kept so apply can run again)"
    echo "  GOST=$GOST_BIN (kept)"
    echo "  API=$API_BIN (kept; process stopped)"
    echo "  api-src=$API_SRC (kept, like CA)"
    echo "  theme src cache=$THEME_SRC (kept, like CA)"
    echo "  cli-cache=$CLI_CACHE (kept, like CA)"
    echo "  operator CLIs are removed only when marked MaxQ-owned"
    echo "state=reverted"
  } >> "$REVERT_LOG"

  echo "MaxQ reverted. tombstone=$REVERT_LOG"
}

cmd_status() {
  if is_applied; then
    echo "applied"
  else
    echo "reverted"
  fi
}

# --- proxy CLI --------------------------------------------------------------

cmd_proxy_status() {
  load_settings
  local run="stopped"
  gost_is_running && run="running"
  echo "proxy.enabled=$GOST_ENABLED"
  echo "proxy.listen=$GOST_LISTEN"
  echo "proxy.upstream=${GOST_UPSTREAM}"
  echo "proxy.iface=${GOST_IFACE}"
  echo "proxy.intercept=$GOST_INTERCEPT"
  echo "proxy.gost=$run"
  echo "proxy.gost_bin=$GOST_BIN"
  echo "proxy.gost_version=$(gost_version)"
  echo "proxy.ca=$CA_PEM"
  echo "proxy.chrome_policy=never (MaxQ does not write ProxyMode/ProxyServer)"
}

clear_token() {
  case "$1" in
    ""|none|-|off|clear) echo "" ;;
    *) echo "$1" ;;
  esac
}

cmd_proxy() {
  local sub="${1:-status}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$sub" in
    status|show|"")
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      cmd_proxy_status
      ;;
    on|enable)
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      load_settings
      GOST_ENABLED=true
      write_toml
      apply_proxy_runtime
      echo "proxy on listen=$GOST_LISTEN intercept=$GOST_INTERCEPT (no Chrome policy)"
      ;;
    off|disable)
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      load_settings
      GOST_ENABLED=false
      write_toml
      apply_proxy_runtime
      echo "proxy off (gost stopped; no Chrome policy written or removed)"
      ;;
    upstream)
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      load_settings
      GOST_UPSTREAM="$(clear_token "${1:-}")"
      write_toml
      apply_proxy_runtime
      echo "proxy.upstream=${GOST_UPSTREAM}"
      ;;
    iface|interface|tunnel)
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      load_settings
      GOST_IFACE="$(sanitize_ident "$(clear_token "${1:-}")")"
      write_toml
      apply_proxy_runtime
      echo "proxy.iface=${GOST_IFACE}"
      ;;
    intercept|mitm)
      [ -f "$TOML" ] || die "not applied; run maxq apply first"
      load_settings
      case "${1:-}" in
        on|true|1|enable) GOST_INTERCEPT=true ;;
        off|false|0|disable|"") GOST_INTERCEPT=false ;;
        *) die "usage: maxq proxy intercept on|off" ;;
      esac
      write_toml
      apply_proxy_runtime
      echo "proxy.intercept=$GOST_INTERCEPT"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "maxq: unknown proxy subcommand: $sub" >&2
      usage >&2
      exit 2
      ;;
  esac
}

# --- prove ------------------------------------------------------------------

PROVE_PASS=0
PROVE_FAIL=0

prove_ok() {
  local name="$1"
  shift
  if "$@"; then
    echo "[PASS] $name"
    PROVE_PASS=$((PROVE_PASS + 1))
    return 0
  fi
  echo "[FAIL] $name"
  PROVE_FAIL=$((PROVE_FAIL + 1))
  return 0
}

prove_grep() {
  local name="$1" file="$2" pat="$3"
  if [ -f "$file" ] && grep -qE "$pat" "$file"; then
    echo "[PASS] $name"
    PROVE_PASS=$((PROVE_PASS + 1))
  else
    echo "[FAIL] $name"
    PROVE_FAIL=$((PROVE_FAIL + 1))
  fi
}

prove_nogrep() {
  local name="$1" file="$2" pat="$3"
  if [ ! -f "$file" ] || ! grep -qE "$pat" "$file"; then
    echo "[PASS] $name"
    PROVE_PASS=$((PROVE_PASS + 1))
  else
    echo "[FAIL] $name"
    PROVE_FAIL=$((PROVE_FAIL + 1))
  fi
}

chrome_proxy_policy_absent() {
  # MaxQ must never create these.
  [ ! -e "$CHROME_POLICY_DIR/maxq-proxy.json" ] && \
    [ ! -e /tmp/sand-egress-proxy ] && \
    [ ! -e "$CHROME_CXN_EGRESS" ]
}

cxn_egress_untouched() {
  # We do not recreate cxn-egress.json. If someone else did, still never
  # rewrite it; this check asserts MaxQ left it absent on this computer.
  [ ! -e "$CHROME_CXN_EGRESS" ]
}

assert_applied_tree() {
  prove_ok "persist \$HOME/bin exists" test -d "$BIN"
  prove_ok "persist \$HOME/.config/maxq exists" test -d "$CONFIG"
  prove_ok "persist \$HOME/.local exists" test -d "$LOCAL"
  prove_ok "maxq.toml exists" test -f "$TOML"
  prove_grep "theme mocha" "$TOML" 'theme = "mocha"'
  prove_grep "state=applied in toml" "$TOML" 'state = "applied"'
  prove_grep "gost enabled=false default" "$TOML" '^enabled = false$'
  prove_grep "gost intercept=false default" "$TOML" '^intercept = false$'
  prove_ok "state file applied" test -f "$STATE_FILE"
  prove_grep "state file says applied" "$STATE_FILE" '^applied$'
  prove_ok "managed marker exists" test -f "$MANAGED"
  prove_ok "profile.sh snippet exists" test -f "$PROFILE_SNIPPET"
  prove_ok "maxq-reconcile executable" test -x "$RECONCILE"
  prove_ok "CLI present at \$HOME/bin/maxq" test -x "$BIN/maxq"
  prove_ok "gost binary at \$HOME/bin/gost" test -x "$GOST_BIN"
  prove_ok ".profile has MaxQ markers" has_profile_block "$PREFIX/.profile"
  prove_ok ".bashrc has MaxQ markers" has_profile_block "$PREFIX/.bashrc"
  prove_ok "status reports applied" test "$(cmd_status)" = "applied"
  prove_ok "CA pem exists" test -s "$CA_PEM"
  prove_ok "CA key exists" test -s "$CA_KEY"
  prove_ok "CA readme exists" test -s "$CA_README"
  prove_ok "no Chrome maxq-proxy.json" test ! -e "$CHROME_POLICY_DIR/maxq-proxy.json"
  prove_ok "no /tmp/sand-egress-proxy" test ! -e /tmp/sand-egress-proxy
  prove_ok "cxn-egress.json not recreated" cxn_egress_untouched
  prove_ok "pastel wallpaper present" test -s "$WALLPAPER"
  prove_ok "wallpaper is owned" test -s "$WALLPAPER_DIR/.maxq-owned"
  prove_ok "MaxQ launcher executable" test -x "$LAUNCHER_BIN"
  prove_ok "MaxQ launcher desktop entry" test -s "$LAUNCHER_DESKTOP"
  prove_grep "Super+Space launcher shortcut" "$SHORTCUTS_FILE" "Super[+]Space"
  prove_ok "GTK theme gtk.css present" test -s "$GTK_THEME_DIR/gtk-3.0/gtk.css"
  prove_ok "GTK theme index.theme present" test -s "$GTK_THEME_DIR/index.theme"
  prove_ok "cursor theme index.theme present" test -s "$CURSOR_DIR/index.theme"
  prove_ok "gtk-3.0 settings.ini MaxQ block" has_profile_block "$GTK3_INI"
  prove_ok "Ghostty Mocha theme file present" test -s "$GHOSTTY_THEME_FILE"
  prove_ok "Ghostty config MaxQ block" has_profile_block "$GHOSTTY_CONFIG"
  prove_ok "Chrome unpacked manifest present" test -s "$CHROME_THEME_DIR/manifest.json"
  prove_grep "Chrome theme note documents store id" "$CHROME_THEME_DIR/MAXQ.txt" "$CHROME_STORE_ID"
  prove_ok "clis.txt present on apply" test -s "$CLIS_TXT"
  prove_ok "managed-clis dir present on apply" test -d "$MANAGED_CLIS"
  prove_ok "opencode present on apply" test -x "$BIN/opencode"
  prove_ok "tailscale present on apply" test -x "$BIN/tailscale"
  prove_ok "maxq-api binary at \$HOME/bin/maxq-api" test -x "$API_BIN"
  prove_ok "api.toml exists" test -f "$API_TOML"
  prove_grep "api listen loopback" "$API_TOML" 'listen = "127.0.0.1:7432"'
  prove_ok "api running after apply" api_is_running
  prove_ok "GET /status is 200 after apply" api_status_200
  prove_ok "GET /status json state applied" api_status_applied
  prove_ok "GET / serves settings sheet" api_ui_ok
  prove_grep "profile prepends HOME/bin" "$PROFILE_SNIPPET" 'PATH="\$HOME/bin:\$PATH"'
  local _n
  if [ -d "$MANAGED_CLIS" ]; then
    for _n in $(ls "$MANAGED_CLIS" 2>/dev/null || true); do
      prove_ok "owned CLI $_n present on apply" test -x "$BIN/$_n"
    done
  fi
}

not_has_profile_block() {
  ! has_profile_block "$1"
}

assert_reverted_tree() {
  prove_ok "maxq.toml gone" test ! -e "$TOML"
  prove_ok "profile.sh snippet gone" test ! -e "$PROFILE_SNIPPET"
  prove_ok "managed marker gone" test ! -e "$MANAGED"
  prove_ok "maxq-reconcile gone" test ! -e "$RECONCILE"
  prove_ok "gost.yml gone" test ! -e "$GOST_YML"
  prove_ok "tombstone last-revert.log exists" test -s "$REVERT_LOG"
  prove_grep "tombstone records revert" "$REVERT_LOG" 'maxq revert'
  prove_ok "state file reverted" test -f "$STATE_FILE"
  prove_grep "state file says reverted" "$STATE_FILE" '^reverted$'
  prove_ok ".profile MaxQ markers gone" not_has_profile_block "$PREFIX/.profile"
  prove_ok ".bashrc MaxQ markers gone" not_has_profile_block "$PREFIX/.bashrc"
  prove_ok "status reports reverted" test "$(cmd_status)" = "reverted"
  prove_ok "CA pem kept across revert" test -s "$CA_PEM"
  prove_ok "CA key kept across revert" test -s "$CA_KEY"
  prove_ok "gost binary kept across revert" test -x "$GOST_BIN"
  prove_ok "gost not running after revert" gost_not_running
  prove_ok "api not running after revert" api_not_running
  prove_ok "api port down after revert" api_port_down
  prove_ok "api.toml gone on revert" test ! -e "$API_TOML"
  prove_ok "maxq-api binary kept across revert" test -x "$API_BIN"
  prove_ok "no Chrome maxq-proxy.json after revert" test ! -e "$CHROME_POLICY_DIR/maxq-proxy.json"
  prove_ok "cxn-egress.json still absent" cxn_egress_untouched
  prove_ok "wallpaper gone on revert" test ! -e "$WALLPAPER"
  prove_ok "GTK theme dir gone on revert" test ! -e "$GTK_THEME_DIR"
  prove_ok "cursor theme dir gone on revert" test ! -e "$CURSOR_DIR"
  prove_ok "Chrome unpacked theme gone on revert" test ! -e "$CHROME_THEME_DIR"
  prove_ok "Ghostty Mocha theme file gone on revert" test ! -e "$GHOSTTY_THEME_FILE"
  prove_ok "Ghostty MaxQ block gone on revert" not_has_profile_block "$GHOSTTY_CONFIG"
  prove_ok "gtk-3.0 MaxQ block gone on revert" not_has_profile_block "$GTK3_INI"
  prove_ok "managed-clis gone on revert" test ! -e "$MANAGED_CLIS"
  prove_ok "clis.txt gone on revert" test ! -e "$CLIS_TXT"
  prove_ok "cli-cache kept across revert" test -d "$CLI_CACHE"
}

assert_proxy_toggle() {
  echo "-- proxy on (gost process only, intercept=false, no Chrome policy) --"
  cmd_proxy on
  prove_ok "gost running after proxy on" gost_is_running
  prove_grep "toml enabled true" "$TOML" '^enabled = true$'
  prove_grep "toml intercept still false" "$TOML" '^intercept = false$'
  prove_ok "gost.yml written" test -s "$GOST_YML"
  prove_nogrep "gost.yml has no mitm while intercept=false" "$GOST_YML" 'mitm.certFile'
  prove_ok "no Chrome maxq-proxy.json after proxy on" test ! -e "$CHROME_POLICY_DIR/maxq-proxy.json"
  prove_ok "cxn-egress.json not written by proxy on" cxn_egress_untouched
  prove_ok "sand.json left in place" test -f "$CHROME_POLICY_DIR/sand.json"
  prove_ok "no /tmp/sand-egress-proxy after proxy on" test ! -e /tmp/sand-egress-proxy

  local host port
  host="$(gost_listen_host)"
  port="$(gost_listen_port)"
  prove_ok "gost listening on loopback" python3 -c "import socket,sys; s=socket.socket(); s.settimeout(2); s.connect((sys.argv[1], int(sys.argv[2]))); s.close()" "$host" "$port"

  echo "-- proxy upstream/iface roundtrip then clear --"
  cmd_proxy upstream "http://127.0.0.1:9"
  prove_grep "upstream persisted" "$TOML" 'upstream = "http://127.0.0.1:9"'
  cmd_proxy iface lo
  prove_grep "iface persisted" "$TOML" 'iface = "lo"'
  cmd_proxy upstream none
  cmd_proxy iface none
  prove_grep "upstream cleared" "$TOML" 'upstream = ""'
  prove_grep "iface cleared" "$TOML" 'iface = ""'

  echo "-- proxy off (leave gost enabled=false, no intercept) --"
  cmd_proxy off
  prove_ok "gost not running after proxy off" gost_not_running
  prove_grep "toml enabled false after off" "$TOML" '^enabled = false$'
  prove_grep "toml intercept false after off" "$TOML" '^intercept = false$'
  prove_ok "no Chrome maxq-proxy.json after proxy off" test ! -e "$CHROME_POLICY_DIR/maxq-proxy.json"
  prove_ok "cxn-egress.json still absent after proxy off" cxn_egress_untouched
}

cmd_prove() {
  set +e
  local start_utc host self
  start_utc="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  host="$(hostname 2>/dev/null || echo unknown)"
  self="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"

  local had_ssh=0 had_chrome=0 had_github_key=0
  local owned_snapshot=""
  [ -d "$PREFIX/.ssh" ] && had_ssh=1
  [ -e "$PREFIX/.ssh/github-0sm0s1z" ] && had_github_key=1
  ls -d "$PREFIX"/chrome-profile* >/dev/null 2>&1 && had_chrome=1

  echo "=== MaxQ prove ==="
  echo "version=$MAXQ_VERSION"
  echo "host=$host"
  echo "prefix=$PREFIX"
  echo "self=$self"
  echo "started_utc=$start_utc"
  echo "initial_status=$(cmd_status)"
  echo

  echo "-- step 1: revert if applied --"
  if is_applied; then
    cmd_revert
  else
    echo "already reverted; skipping initial revert"
  fi
  echo

  echo "-- step 2: apply --"
  cmd_apply
  owned_snapshot="$(ls "$MANAGED_CLIS" 2>/dev/null | tr '\n' ' ')"
  echo "owned_clis=${owned_snapshot}"
  echo "-- assert applied --"
  assert_applied_tree
  echo

  echo "-- step 2b: proxy on/off (do not leave proxy ON; no Chrome policy) --"
  assert_proxy_toggle
  echo

  echo "-- step 3: revert --"
  cmd_revert
  echo "-- assert reverted (markers gone, CA kept, tombstone present) --"
  assert_reverted_tree

  if [ "$had_ssh" -eq 1 ]; then
    prove_ok "SSH directory preserved" test -d "$PREFIX/.ssh"
  fi
  if [ "$had_github_key" -eq 1 ]; then
    prove_ok "github-0sm0s1z key preserved" test -e "$PREFIX/.ssh/github-0sm0s1z"
  fi
  if [ "$had_chrome" -eq 1 ]; then
    prove_ok "Chrome profiles preserved" sh -c "ls -d \"$PREFIX\"/chrome-profile* >/dev/null 2>&1"
  fi
  prove_ok "HOME still exists" test -d "$PREFIX"
  local _n
  for _n in $owned_snapshot; do
    prove_ok "owned CLI $_n gone on revert" test ! -e "$BIN/$_n"
  done
  echo

  echo "-- step 4: apply again (leave APPLIED, gost enabled=false) --"
  cmd_apply
  echo "-- assert applied (final) --"
  assert_applied_tree
  prove_ok "final gost not running (enabled=false)" gost_not_running
  prove_ok "final API up" api_is_running
  prove_ok "final GET /status is 200" api_status_200
  prove_grep "final intercept false" "$TOML" '^intercept = false$'
  for _n in $owned_snapshot; do
    prove_ok "owned CLI $_n restored on final apply" test -x "$BIN/$_n"
  done
  echo

  local result="PASS"
  if [ "$PROVE_FAIL" -ne 0 ]; then
    result="FAIL"
  fi
  echo "=== MaxQ proof report ==="
  echo "result=$result"
  echo "passed=$PROVE_PASS"
  echo "failed=$PROVE_FAIL"
  echo "final_status=$(cmd_status)"
  echo "final_theme=$(grep -E '^theme' "$TOML" 2>/dev/null || true)"
  echo "gost=$(grep -E '^enabled' "$TOML" 2>/dev/null | head -n1 || true)"
  echo "intercept=$(grep -E '^intercept' "$TOML" 2>/dev/null | head -n1 || true)"
  echo "api_listen=${API_LISTEN:-127.0.0.1:7432}"
  echo "api_url=http://127.0.0.1:7432/"
  echo "gost_version=$(gost_version)"
  echo "ca=$CA_PEM"
  echo "chrome_proxy_policy=never"
  echo "chrome_theme_store_id=$CHROME_STORE_ID"
  echo "chrome_theme_live=skipped (unpacked files only)"
  echo "ghostty_bin=skipped (no official linux amd64)"
  echo "clis_installed=$(toml_clis installed "")"
  echo "clis_skipped=$(toml_clis skipped "")"
  echo "ended_utc=$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
  echo "left_state=APPLIED"

  if [ "$result" = "PASS" ]; then
    exit 0
  fi
  exit 1
}

main() {
  local cmd="${1:-status}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    apply|configure) cmd_apply "$@" ;;
    revert|unconfigure) cmd_revert "$@" ;;
    status) cmd_status "$@" ;;
    prove) cmd_prove "$@" ;;
    proxy) cmd_proxy "$@" ;;
    help|-h|--help) usage ;;
    version|-V|--version) echo "$MAXQ_VERSION" ;;
    *)
      echo "maxq: unknown command: $cmd" >&2
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
