#!/usr/bin/env bash
# constellation-MaxQ CLI
# Persist-safe under $HOME. Do not put logic in /usr (optional ln -sfn only).
# Commands: apply|configure  revert|unconfigure  status  prove  proxy
# Control API: $HOME/bin/maxq-api on 127.0.0.1:7432 (loopback). Thin Mocha sheet at /.
# GOST is the local CONNECT proxy. MITM intercept defaults to false.
# Never write Chrome managed ProxyMode/ProxyServer policies.
set -euo pipefail

MAXQ_VERSION="0.5.0"
PREFIX="${MAXQ_HOME:-$HOME}"
BIN="$PREFIX/bin"
CONFIG="$PREFIX/.config/maxq"
LOCAL="$PREFIX/.local"
TOML="$CONFIG/maxq.toml"
STATE_FILE="$CONFIG/state"
PROFILE_SNIPPET="$CONFIG/profile.sh"
MANAGED="$CONFIG/managed"
RECONCILE="$BIN/maxq-reconcile"
REVERT_LOG="$CONFIG/last-revert.log"
BEGIN_MARK="# >>> maxq begin >>>"
END_MARK="# <<< maxq end <<<"
USR_LINK="/usr/local/bin/maxq"

GOST_BIN="$BIN/gost"
GOST_YML="$CONFIG/gost.yml"
GOST_PID="$CONFIG/gost.pid"
GOST_LOG="$CONFIG/gost.log"
GOST_REL_VERSION="3.2.6"
GOST_REL_URL="https://github.com/go-gost/gost/releases/download/v${GOST_REL_VERSION}/gost_${GOST_REL_VERSION}_linux_amd64.tar.gz"

API_BIN="$BIN/maxq-api"
API_PID="$CONFIG/api.pid"
API_LOG="$CONFIG/api.log"
API_TOML="$CONFIG/api.toml"
API_SRC="$CONFIG/api-src"
API_LISTEN="127.0.0.1:7432"

CA_DIR="$CONFIG/ca"
CA_KEY="$CA_DIR/maxq-ca.key"
CA_PEM="$CA_DIR/maxq-ca.pem"
CA_DER="$CA_DIR/maxq-ca.der"
CA_README="$CA_DIR/README.md"

CLI_CACHE="$CONFIG/cli-cache"
MANAGED_CLIS="$CONFIG/managed-clis"
CLIS_TXT="$CONFIG/clis.txt"
CLI_INSTALLED=""
CLI_SKIPPED=""

# Chrome CONNECT proxy policies — never write or restore these.
CHROME_POLICY_DIR="/etc/opt/chrome/policies/managed"
CHROME_CXN_EGRESS="$CHROME_POLICY_DIR/cxn-egress.json"

usage() {
  cat <<EOF
maxq ${MAXQ_VERSION} — take your Grok Bot to MaxQ.

Usage: maxq <command>

  apply, configure     Idempotent desired-state apply (persist under \$HOME)
  revert, unconfigure  Remove MaxQ-owned files/markers only (not home/SSH/Chrome)
  status               Print applied or reverted
  prove                Revert/apply/assert cycle; leave APPLIED; exit 0 on pass
  proxy                Show GOST proxy settings
  proxy on|off         Enable/disable local GOST (process + toml; no Chrome policy)
  proxy upstream <url> Set upstream hop (empty/none to clear)
  proxy iface <name>   Set outbound interface/tunnel (empty/none to clear)
  proxy intercept on|off
                       TLS MITM flag (default off). Does not install Chrome trust.
  help                 This help
  version              Print version

Control API (loopback): http://127.0.0.1:7432/  (thin Mocha sheet)

Environment:
  MAXQ_HOME    Prefix (default: \$HOME)

Persist: \$HOME/bin, \$HOME/.config/maxq, \$HOME/.local
Theme:   Catppuccin Mocha (latte is a future flag only)
GOST:    \$HOME/bin/gost  (go-gost ${GOST_REL_VERSION})
CA:      \$HOME/.config/maxq/ca  (kept across revert)
CLIs:    herdr fx grok codex claude opencode tailscale into \$HOME/bin
         (skip + document if no linux amd64 binary; managed by MaxQ)
Proxy:   local GOST only. MaxQ never writes Chrome ProxyMode/ProxyServer.
Chrome:  theme files unpacked under \$HOME/.local/share/maxq; not live-applied.
API:     \$HOME/bin/maxq-api on 127.0.0.1:7432 (or api.toml). apply starts; revert stops.
EOF
}

die() { echo "maxq: $*" >&2; exit 1; }

is_applied() {
  if [ -f "$STATE_FILE" ]; then
    [ "$(tr -d '[:space:]' < "$STATE_FILE" 2>/dev/null || true)" = "applied" ]
    return $?
  fi
  [ -f "$TOML" ] && grep -q '^state = "applied"' "$TOML" 2>/dev/null
}

install_self() {
  mkdir -p "$BIN"
  local src dest
  src="$(readlink -f "$0" 2>/dev/null || true)"
  dest="$(readlink -f "$BIN/maxq" 2>/dev/null || true)"
  if [ -n "$src" ] && [ -f "$src" ] && [ "$src" != "$dest" ]; then
    cp -f "$src" "$BIN/maxq"
  fi
  if [ -f "$BIN/maxq" ]; then
    chmod +x "$BIN/maxq"
  fi
}

optional_usr_link() {
  if [ -x "$BIN/maxq" ] && [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
    ln -sfn "$BIN/maxq" "$USR_LINK"
  fi
}

remove_optional_usr_link() {
  if [ -L "$USR_LINK" ] && [ -w /usr/local/bin ]; then
    local target
    target="$(readlink "$USR_LINK" 2>/dev/null || true)"
    if [ "$target" = "$BIN/maxq" ]; then
      rm -f "$USR_LINK"
    fi
  fi
}

# --- toml -------------------------------------------------------------------

toml_unquote() {
  local v="$1"
  v="${v#\"}"
  v="${v%\"}"
  printf '%s' "$v"
}

toml_top() {
  local key="$1" def="$2" f="${3:-$TOML}"
  if [ ! -f "$f" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  local line
  line="$(awk -v k="$key" '
    /^\[/ { exit }
    $0 ~ "^" k "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      print
      exit
    }
  ' "$f")"
  if [ -z "${line:-}" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  printf '%s\n' "$(toml_unquote "$line")"
}

toml_gost() {
  local key="$1" def="$2" f="${3:-$TOML}"
  if [ ! -f "$f" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  local line
  line="$(awk -v k="$key" '
    /^\[gost\]/ { ins=1; next }
    /^\[/ { ins=0 }
    ins && $0 ~ "^" k "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      print
      exit
    }
  ' "$f")"
  if [ -z "${line:-}" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  printf '%s\n' "$(toml_unquote "$line")"
}

toml_clis() {
  local key="$1" def="$2" f="${3:-$TOML}"
  if [ ! -f "$f" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  local line
  line="$(awk -v k="$key" '
    /^\[clis\]/ { ins=1; next }
    /^\[/ { ins=0 }
    ins && $0 ~ "^" k "[[:space:]]*=" {
      sub(/^[^=]*=[[:space:]]*/, "")
      print
      exit
    }
  ' "$f")"
  if [ -z "${line:-}" ]; then
    printf '%s\n' "$def"
    return 0
  fi
  printf '%s\n' "$(toml_unquote "$line")"
}

norm_bool() {
  case "$1" in
    true|TRUE|True|on|ON|yes|YES|1) echo true ;;
    *) echo false ;;
  esac
}

load_settings() {
  THEME="$(toml_top theme mocha)"
  IDENTITY="$(toml_top identity grokbot)"
  [ -n "$THEME" ] || THEME="mocha"
  [ -n "$IDENTITY" ] || IDENTITY="grokbot"
  GOST_ENABLED="$(norm_bool "$(toml_gost enabled false)")"
  GOST_LISTEN="$(toml_gost listen "127.0.0.1:8080")"
  GOST_UPSTREAM="$(toml_gost upstream "")"
  GOST_IFACE="$(toml_gost iface "")"
  GOST_INTERCEPT="$(norm_bool "$(toml_gost intercept false)")"
  [ -n "$GOST_LISTEN" ] || GOST_LISTEN="127.0.0.1:8080"
  CLI_INSTALLED="$(toml_clis installed "")"
  CLI_SKIPPED="$(toml_clis skipped "")"
  sanitize_listen
}

sanitize_listen() {
  # Stay off 10.0.0.0/16. Local CONNECT proxy binds loopback only by default.
  case "$GOST_LISTEN" in
    10.0.*|\[::\]:*|0.0.0.0:*)
      echo "maxq: refusing non-loopback listen '$GOST_LISTEN'; using 127.0.0.1:8080" >&2
      GOST_LISTEN="127.0.0.1:8080"
      ;;
  esac
}

sanitize_ident() {
  # iface: alnum _ . : -
  local v="$1"
  if [ -z "$v" ]; then
    printf ''
    return 0
  fi
  case "$v" in
    *[!A-Za-z0-9_.:-]*)
      die "invalid iface name: $v"
      ;;
  esac
  printf '%s' "$v"
}

write_toml() {
  sanitize_listen
  cat > "$TOML" <<EOF
# constellation-MaxQ desired state (managed — do not edit by hand)
# Catppuccin Mocha is the default theme. latte is a future flag only.
# Proxy is local GOST only. MaxQ never writes Chrome ProxyMode/ProxyServer.

theme = "$THEME"
state = "applied"
identity = "$IDENTITY"

[gost]
enabled = $GOST_ENABLED
listen = "$GOST_LISTEN"
upstream = "$GOST_UPSTREAM"
iface = "$GOST_IFACE"
intercept = $GOST_INTERCEPT

[clis]
installed = "$CLI_INSTALLED"
skipped = "$CLI_SKIPPED"
EOF
}

write_profile_snippet() {
  cat > "$PROFILE_SNIPPET" <<'EOF'
# MaxQ managed profile snippet. Do not edit.
# Prepend persist bin. Kickoff of maxq-reconcile is left to post-Update / herdr.

if [ -d "$HOME/bin" ]; then
  case ":$PATH:" in
    *":$HOME/bin:"*) ;;
    *) PATH="$HOME/bin:$PATH" ;;
  esac
fi
export PATH
export GTK_THEME="MaxQ-Catppuccin-Mocha"
export XCURSOR_THEME="MaxQ-Catppuccin-Mocha"
EOF
}

write_reconcile() {
  cat > "$RECONCILE" <<'EOF'
#!/usr/bin/env bash
# MaxQ desired-state reconciler (post Update).
# Recreates persist layout and optional /usr/local/bin link. No /usr logic.
# Does not write Chrome policies.
set -euo pipefail
PREFIX="${MAXQ_HOME:-$HOME}"
mkdir -p "$PREFIX/bin" "$PREFIX/.config/maxq" "$PREFIX/.local" "$PREFIX/.config/maxq/ca" "$PREFIX/.config/maxq/theme" "$PREFIX/.config/maxq/cli-cache" "$PREFIX/.config/maxq/api-src" "$PREFIX/.local/share/themes" "$PREFIX/.local/share/icons" "$PREFIX/.local/share/backgrounds" "$PREFIX/.local/share/maxq"
if [ -x "$PREFIX/bin/maxq" ] && [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
  ln -sfn "$PREFIX/bin/maxq" /usr/local/bin/maxq
fi
exit 0
EOF
  chmod +x "$RECONCILE"
}

profile_block() {
  cat <<EOF
$BEGIN_MARK
# MaxQ (managed) — PATH + kickoff. Do not edit this block.
if [ -r "\$HOME/.config/maxq/profile.sh" ]; then
  . "\$HOME/.config/maxq/profile.sh"
fi
$END_MARK
EOF
}

has_profile_block() {
  local f="$1"
  [ -f "$f" ] && grep -qF "$BEGIN_MARK" "$f"
}

install_profile_hook() {
  local f="$1"
  if [ ! -f "$f" ]; then
    touch "$f"
  fi
  if has_profile_block "$f"; then
    return 0
  fi
  if [ -s "$f" ] && [ "$(tail -c 1 "$f" | wc -l)" -eq 0 ]; then
    printf '\n' >> "$f"
  fi
  printf '\n' >> "$f"
  profile_block >> "$f"
}

strip_profile_hook() {
  local f="$1"
  [ -f "$f" ] || return 0
  if ! has_profile_block "$f"; then
    return 0
  fi
  local tmp
  tmp="$(mktemp "${f}.maxq.XXXXXX")"
  awk -v b="$BEGIN_MARK" -v e="$END_MARK" '
    $0 == b { skip=1; next }
    $0 == e { skip=0; next }
    !skip { print }
  ' "$f" > "$tmp"
  awk '
    { lines[NR]=$0 }
    END {
      end=NR
      while (end>0 && lines[end] ~ /^$/) end--
      for (i=1;i<=end;i++) print lines[i]
      if (end>0) print ""
    }
  ' "$tmp" > "$f"
  rm -f "$tmp"
}

# --- gost binary ------------------------------------------------------------

install_gost_binary() {
  mkdir -p "$BIN"
  if [ -x "$GOST_BIN" ] && "$GOST_BIN" -V >/dev/null 2>&1; then
    return 0
  fi
  local tmp
  tmp="$(mktemp -d "${TMPDIR:-/tmp}/maxq-gost.XXXXXX")"
  if [ -x /tmp/gost-dl/gost ]; then
    cp -f /tmp/gost-dl/gost "$GOST_BIN"
    chmod +x "$GOST_BIN"
    rm -rf "$tmp"
    return 0
  fi
  echo "maxq: installing go-gost ${GOST_REL_VERSION} -> $GOST_BIN"
  if ! curl -fsSL -o "$tmp/gost.tgz" "$GOST_REL_URL"; then
    rm -rf "$tmp"
    die "failed to download GOST from $GOST_REL_URL"
  fi
  tar -xzf "$tmp/gost.tgz" -C "$tmp"
  if [ ! -f "$tmp/gost" ]; then
    rm -rf "$tmp"
    die "GOST tarball missing gost binary"
  fi
  cp -f "$tmp/gost" "$GOST_BIN"
  chmod +x "$GOST_BIN"
  rm -rf "$tmp"
  "$GOST_BIN" -V >/dev/null || die "gost binary not executable"
}

gost_version() {
  if [ -x "$GOST_BIN" ]; then
    "$GOST_BIN" -V 2>/dev/null || echo "gost (unreadable)"
  else
    echo "missing"
  fi
}

# --- CA ---------------------------------------------------------------------

ensure_ca() {
  mkdir -p "$CA_DIR"
  if [ ! -f "$CA_KEY" ] || [ ! -f "$CA_PEM" ]; then
    openssl req -new -x509 -days 3650 -nodes \
      -newkey rsa:2048 \
      -keyout "$CA_KEY" \
      -out "$CA_PEM" \
      -subj "/CN=MaxQ Local CA/O=constellation-MaxQ/OU=grokbot" \
      >/dev/null 2>&1
    chmod 600 "$CA_KEY"
    chmod 644 "$CA_PEM"
  fi
  if [ ! -f "$CA_DER" ] && [ -f "$CA_PEM" ]; then
    openssl x509 -in "$CA_PEM" -outform DER -out "$CA_DER" >/dev/null 2>&1 || true
  fi
  write_ca_readme
}

write_ca_readme() {
  cat > "$CA_README" <<EOF
# MaxQ local CA

Path (persist, kept across \`maxq revert\`):

- PEM: $CA_PEM
- KEY: $CA_KEY
- DER: $CA_DER

MITM is **off by default** (\`[gost] intercept = false\`). GOST is a CONNECT
proxy only until you turn intercept on. MaxQ does **not** write Chrome
managed policies (no ProxyMode, no ProxyServer, no maxq-proxy.json) and
does **not** install this CA into /usr.

## Trust install (manual)

System trust (Debian/Ubuntu, needs sudo — MaxQ will not do this for you):

    sudo cp $CA_PEM /usr/local/share/ca-certificates/maxq-ca.crt
    sudo update-ca-certificates

Chrome / Chromium: import the PEM as an authority that trusts websites,
or set enterprise \`CACertificates\` yourself. MaxQ will not drop files
into /etc/opt/chrome/policies/managed/.

To enable TLS intercept after trusting the CA:

    maxq proxy intercept on
    maxq proxy on

Leave intercept off to keep ChatGPT and other TLS sessions intact.
EOF
}

# --- gost process (pidfile; herdr not required) -----------------------------

gost_listen_host() {
  local l="${GOST_LISTEN:-127.0.0.1:8080}"
  case "$l" in
    :*) echo "127.0.0.1" ;;
    *) echo "${l%:*}" ;;
  esac
}

gost_listen_port() {
  local l="${GOST_LISTEN:-127.0.0.1:8080}"
  echo "${l##*:}"
}

parse_upstream() {
  # sets UP_TYPE UP_ADDR from GOST_UPSTREAM
  UP_TYPE="http"
  UP_ADDR=""
  local u="${GOST_UPSTREAM:-}"
  [ -n "$u" ] || return 0
  case "$u" in
    socks5://*|socks://*)
      UP_TYPE="socks5"
      u="${u#*://}"
      ;;
    socks5s://*|socks5+tls://*)
      UP_TYPE="socks5"
      u="${u#*://}"
      ;;
    https://*)
      UP_TYPE="http"
      u="${u#https://}"
      ;;
    http://*)
      UP_TYPE="http"
      u="${u#http://}"
      ;;
  esac
  u="${u%%/*}"
  UP_ADDR="$u"
}

write_gost_yml() {
  sanitize_listen
  local iface_line="" meta="" chain_ref=""
  if [ -n "$GOST_IFACE" ] && [ -z "$GOST_UPSTREAM" ]; then
    iface_line="  interface: ${GOST_IFACE}"
  fi
  if [ -n "$GOST_UPSTREAM" ]; then
    chain_ref="    chain: maxq-up"
  fi
  if [ "$GOST_INTERCEPT" = "true" ]; then
    meta="    metadata:
      sniffing: true
      mitm.certFile: ${CA_PEM}
      mitm.keyFile: ${CA_KEY}"
  fi
  {
    echo "# constellation-MaxQ gost config (managed — do not edit)"
    echo "# CONNECT proxy. intercept=${GOST_INTERCEPT}. No Chrome policy."
    echo "services:"
    echo "- name: maxq-http"
    echo "  addr: \"${GOST_LISTEN}\""
    [ -n "$iface_line" ] && echo "$iface_line"
    echo "  handler:"
    echo "    type: http"
    [ -n "$chain_ref" ] && echo "$chain_ref"
    [ -n "$meta" ] && printf '%s\n' "$meta"
    echo "  listener:"
    echo "    type: tcp"
    if [ -n "$GOST_UPSTREAM" ]; then
      parse_upstream
      echo "chains:"
      echo "- name: maxq-up"
      echo "  hops:"
      echo "  - name: hop-0"
      echo "    nodes:"
      echo "    - name: node-0"
      echo "      addr: \"${UP_ADDR}\""
      if [ -n "$GOST_IFACE" ]; then
        echo "      interface: ${GOST_IFACE}"
      fi
      echo "      connector:"
      echo "        type: ${UP_TYPE}"
      echo "      dialer:"
      echo "        type: tcp"
    fi
  } > "$GOST_YML"
}

gost_is_running() {
  local pid
  [ -f "$GOST_PID" ] || return 1
  pid="$(tr -d '[:space:]' < "$GOST_PID" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

gost_not_running() {
  ! gost_is_running
}

stop_gost() {
  local pid
  if [ -f "$GOST_PID" ]; then
    pid="$(tr -d '[:space:]' < "$GOST_PID" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      local i=0
      while [ "$i" -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$GOST_PID"
  fi
}

start_gost() {
  install_gost_binary
  ensure_ca
  mkdir -p "$CONFIG"
  write_gost_yml
  stop_gost
  nohup "$GOST_BIN" -C "$GOST_YML" >>"$GOST_LOG" 2>&1 &
  echo $! > "$GOST_PID"
  local i=0
  local port host
  port="$(gost_listen_port)"
  host="$(gost_listen_host)"
  while [ "$i" -lt 40 ]; do
    if gost_is_running && python3 -c "import socket,sys; s=socket.socket(); s.settimeout(0.2); s.connect((sys.argv[1], int(sys.argv[2]))); s.close()" "$host" "$port" 2>/dev/null; then
      return 0
    fi
    sleep 0.1
    i=$((i + 1))
  done
  if gost_is_running; then
    return 0
  fi
  echo "maxq: gost failed to start; last log:" >&2
  tail -n 20 "$GOST_LOG" 2>/dev/null >&2 || true
  return 1
}

apply_proxy_runtime() {
  # Never touch Chrome managed policies.
  if [ "$GOST_ENABLED" = "true" ]; then
    start_gost
  else
    stop_gost
  fi
}

# --- control API (PLAN 18-19; loopback only, thin sheet) --------------------

api_src_candidates() {
  local here src
  src="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
  here="$(cd "$(dirname "$src")" && pwd)"
  printf '%s\n' "$here/../cmd/maxq-api"
  printf '%s\n' "$here/cmd/maxq-api"
  printf '%s\n' "$here/../constellation-MaxQ/cmd/maxq-api"
  printf '%s\n' "$API_SRC"
}

seed_api_src() {
  mkdir -p "$API_SRC"
  local cand
  while IFS= read -r cand; do
    [ -n "$cand" ] || continue
    [ -f "$cand/main.go" ] || continue
    if [ "$(readlink -f "$cand" 2>/dev/null || true)" = "$(readlink -f "$API_SRC" 2>/dev/null || true)" ]; then
      continue
    fi
    cp -a "$cand"/. "$API_SRC"/
    return 0
  done < <(api_src_candidates)
}

load_api_listen() {
  API_LISTEN="$(toml_top listen "127.0.0.1:7432" "$API_TOML")"
  [ -n "$API_LISTEN" ] || API_LISTEN="127.0.0.1:7432"
  sanitize_api_listen
}

sanitize_api_listen() {
  case "$API_LISTEN" in
    10.0.*|\[::\]:*|0.0.0.0:*|\[::0\]:*)
      echo "maxq: refusing non-loopback api listen '$API_LISTEN'; using 127.0.0.1:7432" >&2
      API_LISTEN="127.0.0.1:7432"
      ;;
    127.0.0.1:*|localhost:*)
      ;;
    *)
      echo "maxq: refusing non-loopback api listen '$API_LISTEN'; using 127.0.0.1:7432" >&2
      API_LISTEN="127.0.0.1:7432"
      ;;
  esac
}

write_api_toml() {
  sanitize_api_listen
  cat > "$API_TOML" <<EOF
# constellation-MaxQ control API (managed — do not edit by hand)
# Loopback only. Never bind 0.0.0.0 or 10.0.0.0/16.
# Thin Mocha sheet at /. MaxQ never writes Chrome ProxyMode/ProxyServer.

listen = "$API_LISTEN"
EOF
}

install_api_binary() {
  mkdir -p "$BIN"
  seed_api_src
  if command -v go >/dev/null 2>&1 && [ -f "$API_SRC/main.go" ]; then
    if [ -x "$API_BIN" ] && [ "$API_BIN" -nt "$API_SRC/main.go" ] \
      && [ "$API_BIN" -nt "$API_SRC/ui/sheet.js" ] \
      && [ "$API_BIN" -nt "$API_SRC/ui/index.html" ] \
      && [ "$API_BIN" -nt "$API_SRC/ui/mocha.css" ]; then
      return 0
    fi
    echo "maxq: building maxq-api -> $API_BIN"
    if ! (
      cd "$API_SRC"
      CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o "$API_BIN" .
    ); then
      die "failed to build maxq-api"
    fi
    chmod +x "$API_BIN"
    return 0
  fi
  if [ -x "$API_BIN" ]; then
    return 0
  fi
  die "maxq-api missing (need go + cmd/maxq-api source, or a prior binary)"
}

api_listen_host() {
  local l="${API_LISTEN:-127.0.0.1:7432}"
  case "$l" in
    :*) echo "127.0.0.1" ;;
    *) echo "${l%:*}" ;;
  esac
}

api_listen_port() {
  local l="${API_LISTEN:-127.0.0.1:7432}"
  echo "${l##*:}"
}

api_is_running() {
  local pid
  [ -f "$API_PID" ] || return 1
  pid="$(tr -d '[:space:]' < "$API_PID" 2>/dev/null || true)"
  [ -n "$pid" ] || return 1
  kill -0 "$pid" 2>/dev/null
}

api_not_running() {
  ! api_is_running
}

api_port_down() {
  local host port
  host="$(api_listen_host)"
  port="$(api_listen_port)"
  ! python3 -c "import socket,sys; s=socket.socket(); s.settimeout(0.3); s.connect((sys.argv[1], int(sys.argv[2]))); s.close()" "$host" "$port" 2>/dev/null
}

api_status_200() {
  local host port code
  host="$(api_listen_host)"
  port="$(api_listen_port)"
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 1 "http://${host}:${port}/status" || true)"
  [ "$code" = "200" ]
}

api_status_applied() {
  local host port body
  host="$(api_listen_host)"
  port="$(api_listen_port)"
  body="$(curl -sf --max-time 2 "http://${host}:${port}/status" || true)"
  printf '%s' "$body" | grep -q '"state":"applied"'
}

api_ui_ok() {
  local host port body
  host="$(api_listen_host)"
  port="$(api_listen_port)"
  body="$(curl -sf --max-time 2 "http://${host}:${port}/" || true)"
  printf '%s' "$body" | grep -q 'MaxQ'
}

stop_api() {
  local pid
  if [ -f "$API_PID" ]; then
    pid="$(tr -d '[:space:]' < "$API_PID" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      local i=0
      while [ "$i" -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
        sleep 0.1
        i=$((i + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -9 "$pid" 2>/dev/null || true
      fi
    fi
    rm -f "$API_PID"
  fi
}

start_api() {
  load_api_listen
  install_api_binary
  write_api_toml
  if api_is_running; then
    local pid
    pid="$(tr -d '[:space:]' < "$API_PID" 2>/dev/null || true)"
    # If apply was invoked by the API itself, do not restart (would drop the HTTP call).
    if [ -n "$pid" ] && { [ "$pid" = "$$" ] || [ "$pid" = "$PPID" ]; }; then
      return 0
    fi
    stop_api
  fi
  : > "$API_LOG"
  nohup env MAXQ_HOME="$PREFIX" "$API_BIN" >>"$API_LOG" 2>&1 &
  echo $! > "$API_PID"
  local i=0 host port
  host="$(api_listen_host)"
  port="$(api_listen_port)"
  while [ "$i" -lt 50 ]; do
    if api_is_running && python3 -c "import socket,sys; s=socket.socket(); s.settimeout(0.2); s.connect((sys.argv[1], int(sys.argv[2]))); s.close()" "$host" "$port" 2>/dev/null; then
      if api_status_200; then
        return 0
      fi
    fi
    sleep 0.1
    i=$((i + 1))
  done
  if api_is_running; then
    return 0
  fi
  echo "maxq: maxq-api failed to start; last log:" >&2
  tail -n 20 "$API_LOG" 2>/dev/null >&2 || true
  return 1
}

