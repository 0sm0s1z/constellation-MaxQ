# sourced by maxq-desktop
GHOSTTY_VERSION="1.3.1"
GHOSTTY_APPIMAGE_URL="https://github.com/pkgforge-dev/ghostty-appimage/releases/download/v${GHOSTTY_VERSION}/Ghostty-${GHOSTTY_VERSION}-x86_64.AppImage"
ghostty_ok(){ [ -x "$G" ] && "$G" --version >/dev/null 2>&1; }
fetch_cached(){ local url="$1" dest="$2"; [ -s "$dest" ] && return 0; mkdir -p "$(dirname "$dest")"; local part="${dest}.part"; if curl -fL --retry 3 --retry-delay 1 -o "$part" "$url" && [ -s "$part" ]; then mv -f "$part" "$dest"; return 0; fi; rm -f "$part"; return 1; }
install_ghostty(){
  if ghostty_ok; then [ -f "$S/ghostty-owned" ] || : > "$S/ghostty-preexisting"; return; fi
  mkdir -p "$C/downloads"; local t app; t="$(mktemp -d "${TMPDIR:-/tmp}/maxq-ghostty.XXXXXX")"; app="$C/downloads/Ghostty-${GHOSTTY_VERSION}-x86_64.AppImage"
  rm -f "$G"
  fetch_cached "$GHOSTTY_APPIMAGE_URL" "$app" || { rm -rf "$t"; fail "Ghostty ${GHOSTTY_VERSION} AppImage download failed"; }
  cp -f "$app" "$G"; chmod +x "$G"
  if ! ghostty_ok; then
    rm -f "$G"; cp -f "$app" "$t/ghostty.AppImage"; chmod +x "$t/ghostty.AppImage"
    (cd "$t" && ./ghostty.AppImage --appimage-extract >/dev/null 2>&1) || { rm -rf "$t"; fail 'Ghostty AppImage extract failed'; }
    rm -rf "$L/opt/ghostty-appimage"; mv "$t/squashfs-root" "$L/opt/ghostty-appimage"
    cat > "$G" <<EOF
#!/usr/bin/env bash
exec "$L/opt/ghostty-appimage/AppRun" "\$@"
EOF
    chmod +x "$G"
  fi
  rm -rf "$t"; ghostty_ok || fail 'Ghostty --version failed'; echo constellation-MaxQ > "$S/ghostty-owned"
}
install_ghostty_desktop(){
  cat > "$GD" <<EOF
[Desktop Entry]
Type=Application
Name=Ghostty
Comment=MaxQ default terminal
Exec=$G
Icon=$I/ghostty.png
Terminal=false
Categories=System;TerminalEmulator;
X-MaxQ-Managed=true
EOF
  cat > "$H/ghostty.desktop" <<EOF
[Xfce Helper]
Name=Ghostty
Category=TerminalEmulator
Command=$G
Parameter=%s
StartupNotify=true
EOF
  cp -f "$GD" "$E/Ghostty.desktop"; chmod +x "$E/Ghostty.desktop"
}
set_default_terminal(){
  [ -f "$S/helper-saved" ] || { grep '^TerminalEmulator=' "$X" 2>/dev/null | tail -1 > "$S/helper-prev" || true; : > "$S/helper-saved"; }
  mkdir -p "$(dirname "$X")"; touch "$X"
  python3 - "$X" "$BEGIN" "$END" <<'PY'
import sys
p,b,e=sys.argv[1:]; out=[]; skip=False
for line in open(p,encoding='utf-8').read().splitlines():
 if line==b: skip=True; continue
 if line==e: skip=False; continue
 if not skip and not line.startswith('TerminalEmulator='): out.append(line)
while out and not out[-1].strip(): out.pop()
if out: out.append('')
out += [b,'TerminalEmulator=ghostty',e]
open(p,'w',encoding='utf-8').write('\n'.join(out)+'\n')
PY
}
restore_default_terminal(){
  [ -f "$X" ] || return 0; local prev=""; [ -f "$S/helper-prev" ] && prev="$(cat "$S/helper-prev")"
  python3 - "$X" "$BEGIN" "$END" "$prev" <<'PY'
import sys
p,b,e,prev=sys.argv[1:]; out=[]; skip=False
for line in open(p,encoding='utf-8').read().splitlines():
 if line==b: skip=True; continue
 if line==e: skip=False; continue
 if not skip and not line.startswith('TerminalEmulator='): out.append(line)
while out and not out[-1].strip(): out.pop()
if prev: out += ([''] if out else [])+[prev]
open(p,'w',encoding='utf-8').write('\n'.join(out)+('\n' if out else ''))
PY
}
